{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Azure Engine",
            "type": "shell",
            "command": "cl",
            "args": [
                "/EHsc",
                "/nologo",
                "src\\main.cpp",
                "/Fe:build\\AzureEngine.exe",
                "/link",
                "user32.lib",
                "gdi32.lib"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            
        }
    ]
}