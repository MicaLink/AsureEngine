{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AzureEngine",
            "type": "shell",
            "command": "cl",
            "args": [
                "/EHsc",
                "/std:c++17",
                "/nologo",

                "/Fobuild\\obj\\",
                "/Febuild\\AzureEngine.exe",

                "src\\main.cpp",

                "src\\Azure8\\CPU.cpp",
                "src\\Azure8\\Memory.cpp",
                "src\\Azure8\\Emulator.cpp",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}