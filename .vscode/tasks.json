{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Azure Engine",
            "type": "shell",
            "command": "cl",
            "args": [
                "/EHsc",
                "/nologo",

                "/Fobuild\\obj\\",

                "src\\main.cpp",

                "src\\Core\\Timer.cpp",

                "src\\Input\\Input.cpp",

                "src\\Graphics\\Renderer.cpp",
                "src\\Graphics\\Animation.cpp",
                "src\\Graphics\\Camera.cpp",
                "src\\Graphics\\Hero.cpp",

                "src\\World\\TileMap.cpp",
                
                "src\\Game\\Player.cpp",
                "src\\Game\\EntityManager.cpp",
                "src\\Game\\Enemy.cpp",
                "src\\Game\\Entity.cpp",
                


                "/Fe:build\\AzureEngine.exe",

                "/link",

                "user32.lib",
                "gdi32.lib"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}